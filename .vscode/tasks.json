{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build EV ChargeHub",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run EV ChargeHub Desktop App",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File run.ps1",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
